{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ec-output-v1.json",
  "title": "E-commerce dispute resolution output",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "assessment", "affected_entities", "root_cause_analysis", "evidence_ids", "financial_resolution", "resolution_actions"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^EC_[0-9]{3}$"},
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_issue", "case_status", "confidence"],
      "properties": {
        "primary_issue": {"enum": ["canceled_order_paid", "unavailable_order_paid", "late_delivery_seller", "late_delivery_logistics", "valid_split_payment", "unsupported_late_claim"]},
        "case_status": {"enum": ["action_required", "no_action"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "affected_entities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_ids", "item_ids", "seller_ids", "payment_ids"],
      "properties": {
        "order_ids": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^:]+$"}},
        "item_ids": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^:]+:[1-9][0-9]*$"}},
        "seller_ids": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^:]+$"}},
        "payment_ids": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^:]+:[1-9][0-9]*$"}}
      }
    },
    "root_cause_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranked_causes", "responsible_parties"],
      "properties": {
        "ranked_causes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["cause_code", "rank"], "properties": {"cause_code": {"enum": ["SELLER_HANDOFF_AFTER_LIMIT", "CARRIER_DELIVERED_AFTER_ESTIMATE", "ORDER_CANCELED_AFTER_PAYMENT", "ORDER_UNAVAILABLE_AFTER_PAYMENT", "MULTIPLE_PAYMENTS_RECONCILED", "DELIVERY_WITHIN_ESTIMATE"]}, "rank": {"type": "integer", "minimum": 1, "maximum": 3}}}},
        "responsible_parties": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["party_type", "party_id"], "properties": {"party_type": {"enum": ["seller", "platform", "logistics_provider"]}, "party_id": {"type": "string", "minLength": 1}}}}
      }
    },
    "evidence_ids": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "financial_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "item_total_brl", "freight_total_brl", "payment_total_brl", "recommended_refund_brl"],
      "properties": {
        "currency": {"const": "BRL"},
        "item_total_brl": {"type": "number", "minimum": 0},
        "freight_total_brl": {"type": "number", "minimum": 0},
        "payment_total_brl": {"type": "number", "minimum": 0},
        "recommended_refund_brl": {"type": "number", "minimum": 0}
      }
    },
    "resolution_actions": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"enum": ["issue_full_refund", "refund_freight", "explain_valid_split_payment", "reject_late_refund"]}}
  }
}
